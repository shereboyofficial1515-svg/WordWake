<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Privacy: there is deliberately NO android.permission.INTERNET. WordWake works fully offline
        and cannot upload anything.
    -->

    <!-- Show the alarm notification and message (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Exact alarms. WordWake is an alarm-clock app, so on Android 13+ it uses USE_EXACT_ALARM
        (granted at install for alarm/clock apps per Play policy). On Android 12/12L it uses
        SCHEDULE_EXACT_ALARM, which the user can revoke; the app handles that with an inexact
        fallback and a warning.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Restore alarms after reboot (AlarmManager alarms do not survive a restart). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Turn the screen on and show the message over the lock screen while ringing. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Foreground service that plays the alarm sound. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Keep the CPU awake only while an alarm is ringing (bounded wake lock). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Lets the app show the standard "allow to run in background" dialog. Needed in practice on
        phones whose power managers withhold even exact alarms (observed on TECNO / HiOS).
        Google Play restricts this permission; an alarm app must justify it in the Play Console.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".WordWakeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordWake"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditScheduleActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SoundLibraryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PermissionsActivity"
            android:exported="false" />

        <!-- Alarm display: separate task so it does not drag the main UI over the lock screen. -->
        <activity
            android:name=".ui.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.wordwake.app.alarm"
            android:theme="@style/Theme.WordWake.Alarm"
            android:turnScreenOn="true" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.AlarmActionReceiver"
            android:exported="false" />

        <!-- System broadcasts are delivered to non-exported receivers. -->
        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
            <!-- Some manufacturers send this instead of BOOT_COMPLETED after a fast boot. -->
            <intent-filter>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
