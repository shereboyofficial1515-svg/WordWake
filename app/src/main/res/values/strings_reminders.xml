    <!-- Delivery problems -->
    <string name="status_delivery_title">This phone is holding back alarms</string>
    <string name="status_delivery_detail">An alert was missed or arrived late. Tap to see what happened and run a test.</string>
    <string name="perm_oem_title">This phone may still hold alarms back</string>
    <string name="state_may_not_ring">Test it</string>
    <string name="perm_oem_text">Some phones stop apps from running in the background even with every setting above allowed. A tested TECNO KM6 did this. WordWake then rings when it is next opened, if the alert is still open, and reports the rest as missed. Run the system test with the screen off to check your phone. For anything important, add a backup alarm in Clock from the reminder\'s menu.</string>
    <string name="menu_clock_backup">Add backup alarm in Clock</string>
    <string name="clock_backup_title">Add a backup alarm in Clock?</string>
    <string name="clock_backup_message">This adds a matching %1$s alarm to your phone\'s Clock app, which keeps working when this phone holds back WordWake. It rings with Clock\'s sound and shows only the title. WordWake cannot change or remove it later, so if you edit or delete this reminder, change the Clock alarm yourself.</string>
    <string name="clock_backup_add">Add alarm</string>
    <string name="clock_backup_done">Backup alarm sent to Clock. Check it there.</string>
    <string name="clock_backup_failed">No Clock app on this phone accepted the alarm.</string>
    <string name="clock_backup_unsupported">Clock can only hold daily, weekly and selected-day alarms, or a one-time alarm within the next 24 hours.</string>

